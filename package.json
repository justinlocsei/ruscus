{
  "name": "ruscus",
  "version": "0.0.4",
  "description": "A TypeScript library for organizing and defining component styles",
  "keywords": [
    "css",
    "components",
    "styles",
    "typescript"
  ],
  "homepage": "https://github.com/justinlocsei/ruscus#readme",
  "bugs": {
    "url": "https://github.com/justinlocsei/ruscus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinlocsei/ruscus.git"
  },
  "license": "MIT",
  "author": "Justin Locsei",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "import": "./dist/vite.mjs",
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    }
  },
  "files": [
    "dist/index.mjs",
    "dist/index.d.mts",
    "dist/vite.mjs",
    "dist/vite.d.mts"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "npm run check:code && npm run check:formatting && npm run check:types",
    "check:code": "biome lint . --error-on-warnings",
    "check:formatting": "biome ci --linter-enabled=false . && dprint check",
    "check:types": "tsc --noEmit",
    "format": "biome check --write --linter-enabled=false . && dprint fmt",
    "generate:types": "node --experimental-strip-types scripts/generate-css-types.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run --reporter verbose",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@webref/css": "^8.7.7",
    "css-tree": "^3.2.1",
    "dprint": "^0.63.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "vite": ">=6.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "dprint@0.63.0": true,
    "esbuild@0.28.2": true
  }
}
