{
  "name": "ruscus",
  "version": "0.0.0",
  "description": "Typed component styles",
  "keywords": [
    "css",
    "components",
    "styles",
    "typescript"
  ],
  "homepage": "https://github.com/justinlocsei/ruscus#readme",
  "bugs": {
    "url": "https://github.com/justinlocsei/ruscus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinlocsei/ruscus.git"
  },
  "author": "Justin Locsei",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist/index.d.mts",
    "dist/index.mjs"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "check": "npm run check:code && npm run check:formatting && npm run check:types",
    "check:code": "biome lint . --error-on-warnings",
    "check:formatting": "biome ci --linter-enabled=false . && dprint check",
    "check:types": "tsc --noEmit",
    "format": "biome check --write --linter-enabled=false . && dprint fmt",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter text"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dprint": "^0.57.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "dprint@0.57.4": true
  }
}
