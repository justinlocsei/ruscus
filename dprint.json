{
  "typescript": {
    "importDeclaration.sortNamedImports": "maintain",
    "lineWidth": 80,
    "module.sortImportDeclarations": "maintain",
    "quoteStyle": "preferSingle",
    "semiColons": "prefer",
    "trailingCommas": "never"
  },
  "json": {
    "trailingCommas": "never"
  },
  "includes": [
    "**/*.{json,mjs,ts}"
  ],
  "excludes": [
    "dist",
    "node_modules",
    "package*.json",
    "src/types/css/properties.ts"
  ],
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/typescript@0.96.1"
  ]
}
